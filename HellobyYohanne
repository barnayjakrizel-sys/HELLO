<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Baby Yohanne Rei's Magic Carousel Baptismal Invitation</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Great Vibes, Playfair Display, Quicksand, Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'sky-pastel': '#E6F4FF',
                        'sky-card': '#D6ECFF',
                        'sky-accent': '#4A90E2',
                        'pink-dusty': '#F5C2D1',
                        'pink-deep': '#E07A9A',
                        'cream-base': '#FFFDF7',
                        'gold-antique': '#D4AF37',
                        'gold-light': '#F3E5AB',
                        'navy-slate': '#24364B',
                    },
                    fontFamily: {
                        'script': ['"Great Vibes"', 'cursive'],
                        'serif-royal': ['"Playfair Display"', 'serif'],
                        'whimsy': ['"Quicksand"', 'sans-serif'],
                        'sans': ['"Inter"', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        /* Base & Smooth Scrolling */
        html {
            scroll-behavior: smooth;
        }
        body {
            background: linear-gradient(180deg, #E8F5FF 0%, #FFFDF7 35%, #F2F9FF 70%, #FFF5F8 100%);
            color: #24364B;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }

        /* Gold Foil Text Gradient */
        .gold-text-gradient {
            background: linear-gradient(135deg, #B8860B 0%, #D4AF37 45%, #F5D76E 70%, #AA771C 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Envelope Floating & Gentle Wobble Animation */
        @keyframes envelopeFloatWobble {
            0%, 100% {
                transform: translateY(0px) rotate(-1.2deg);
            }
            25% {
                transform: translateY(-9px) rotate(1deg);
            }
            50% {
                transform: translateY(-4px) rotate(-0.8deg);
            }
            75% {
                transform: translateY(-11px) rotate(1.3deg);
            }
        }
        .animate-envelope {
            animation: envelopeFloatWobble 4.5s ease-in-out infinite;
        }

        /* Wax Seal Pulse Glow */
        @keyframes sealPulse {
            0%, 100% {
                transform: scale(1);
                box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.7), 0 10px 25px rgba(180, 134, 11, 0.45);
            }
            50% {
                transform: scale(1.08);
                box-shadow: 0 0 0 14px rgba(212, 175, 55, 0), 0 14px 30px rgba(180, 134, 11, 0.65);
            }
        }
        .animate-seal {
            animation: sealPulse 2.2s infinite ease-in-out;
        }

        /* Teddy Bear Flying / Floating Animation */
        @keyframes teddyFloat {
            0%, 100% { transform: translateY(0px) rotate(-3deg); }
            50% { transform: translateY(-14px) rotate(4deg); }
        }
        .animate-teddy {
            animation: teddyFloat 3.6s ease-in-out infinite;
        }

        /* Carousel Gallop Animations */
        @keyframes gallopUp {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-12px); }
        }
        @keyframes gallopDown {
            0%, 100% { transform: translateY(-12px); }
            50% { transform: translateY(0px); }
        }
        .horse-up {
            animation: gallopUp 2.2s ease-in-out infinite;
        }
        .horse-down {
            animation: gallopDown 2.2s ease-in-out infinite;
        }

        /* Twinkling Fairy Lights & Stars */
        @keyframes twinkle {
            0%, 100% { opacity: 0.35; transform: scale(0.85); }
            50% { opacity: 1; transform: scale(1.2); }
        }
        .twinkle-light {
            animation: twinkle 1.8s ease-in-out infinite;
        }

        /* Boat Rocking on Waves */
        @keyframes boatRock {
            0%, 100% { transform: translateY(0px) rotate(-3.5deg); }
            50% { transform: translateY(-7px) rotate(3.5deg); }
        }
        .animate-boat {
            transform-origin: center center;
            animation: boatRock 3.2s ease-in-out infinite;
        }

        /* Bouncing Heart Inside Envelope */
        @keyframes heartBounce {
            0%, 100% { transform: translateY(0px) scale(1); }
            40% { transform: translateY(-14px) scale(1.15); }
            65% { transform: translateY(-4px) scale(0.95); }
        }
        .animate-heart-bounce {
            animation: heartBounce 1.8s ease-in-out infinite;
        }

        /* Chimney Smoke / Floating Hearts Rise */
        @keyframes floatUpSlow {
            0% { transform: translateY(0) scale(0.8); opacity: 0; }
            30% { opacity: 0.9; }
            100% { transform: translateY(-28px) scale(1.2); opacity: 0; }
        }
        .animate-rise {
            animation: floatUpSlow 3s ease-out infinite;
        }

        /* Floating Background Particles */
        @keyframes driftStar {
            0% { transform: translateY(0px) rotate(0deg); opacity: 0.4; }
            50% { transform: translateY(-18px) rotate(180deg); opacity: 0.95; }
            100% { transform: translateY(0px) rotate(360deg); opacity: 0.4; }
        }
        .bg-particle {
            animation: driftStar 6s ease-in-out infinite;
        }

        /* Envelope Opening Transition */
        .envelope-flap {
            transform-origin: top center;
            transition: transform 0.85s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .envelope-opened .envelope-flap {
            transform: rotateX(180deg);
        }
        .envelope-opened .letter-peek {
            transform: translateY(-45px);
        }

        /* Royal Card Styling */
        .royal-card {
            background: rgba(255, 253, 247, 0.92);
            backdrop-filter: blur(8px);
            border: 2px solid rgba(212, 175, 55, 0.45);
            box-shadow: 0 12px 35px -8px rgba(36, 54, 75, 0.1), 0 0 0 4px rgba(255, 255, 255, 0.65);
        }

        /* Sparkle Burst Particle */
        .burst-dot {
            position: fixed;
            pointer-events: none;
            z-index: 9999;
            font-size: 1.35rem;
            transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.9s ease-out;
        }
    </style>
</head>
<body class="min-h-screen relative selection:bg-sky-card selection:text-navy-slate">

    <!-- ===================================================================== -->
    <!-- FLOATING MUSIC TOGGLE & QUICK CUSTOMIZE CONTROLS                      -->
    <!-- ===================================================================== -->
    <div class="fixed top-4 right-4 z-50 flex items-center gap-2">
        <button id="music-toggle-btn"
                onclick="toggleMusic()"
                aria-label="Toggle Background Music"
                class="flex items-center gap-2 px-3.5 py-2 rounded-full bg-cream-base/95 border-2 border-gold-antique shadow-lg text-navy-slate font-whimsy font-bold text-xs sm:text-sm hover:scale-105 active:scale-95 transition">
            <span id="music-icon" class="text-base">🎵</span>
            <span id="music-label" class="hidden sm:inline">Music: Off</span>
        </button>
    </div>

    <!-- Ambient Twinkling Background Stars & Pastel Hearts -->
    <div id="ambient-sky" class="fixed inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true"></div>

    <!-- ===================================================================== -->
    <!-- INTRO OVERLAY: ANIMATED TEDDY BEAR & SEALED MAGIC ENVELOPE            -->
    <!-- ===================================================================== -->
