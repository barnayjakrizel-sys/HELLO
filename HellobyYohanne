                    <div class="bg-cream-base rounded-2xl p-3 border-2 border-gold-antique/50 shadow-sm">
                        <div id="cd-days" class="font-serif-royal text-2xl sm:text-4xl font-bold text-sky-accent">00</div>
                        <div class="font-whimsy text-[11px] sm:text-xs font-bold uppercase tracking-wider text-navy-slate/75 mt-0.5">Days</div>
                    </div>
                    <div class="bg-cream-base rounded-2xl p-3 border-2 border-gold-antique/50 shadow-sm">
                        <div id="cd-hours" class="font-serif-royal text-2xl sm:text-4xl font-bold text-sky-accent">00</div>
                        <div class="font-whimsy text-[11px] sm:text-xs font-bold uppercase tracking-wider text-navy-slate/75 mt-0.5">Hours</div>
                    </div>
                    <div class="bg-cream-base rounded-2xl p-3 border-2 border-gold-antique/50 shadow-sm">
                        <div id="cd-mins" class="font-serif-royal text-2xl sm:text-4xl font-bold text-sky-accent">00</div>
                        <div class="font-whimsy text-[11px] sm:text-xs font-bold uppercase tracking-wider text-navy-slate/75 mt-0.5">Mins</div>
                    </div>
                    <div class="bg-cream-base rounded-2xl p-3 border-2 border-gold-antique/50 shadow-sm">
