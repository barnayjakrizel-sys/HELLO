    <!-- ===================================================================== -->
    <!-- JAVASCRIPT: ENVELOPE ANIMATION, MUSIC BOX LULLABY, COUNTDOWN & RSVP   -->
    <!-- ===================================================================== -->
    <script>
        /* -------------------------------------------------------------------
         * 1. AMBIENT TWINKLING STARS & FLOATING HEARTS GENERATOR
         * ------------------------------------------------------------------- */
        function createAmbientParticles() {
            const sky = document.getElementById('ambient-sky');
            const icons = ['✨', '⭐', '💙', '💗', '🌟'];
            for (let i = 0; i < 22; i++) {
                const el = document.createElement('span');
                el.className = 'bg-particle absolute select-none';
                el.textContent = icons[i % icons.length];
                el.style.left = Math.random() * 96 + '%';
                el.style.top = Math.random() * 96 + '%';
                el.style.fontSize = (12 + Math.random() * 12) + 'px';
                el.style.animationDelay = (Math.random() * 5) + 's';
                el.style.animationDuration = (5 + Math.random() * 4) + 's';
                sky.appendChild(el);
            }
        }

        /* -------------------------------------------------------------------
         * 2. WEB AUDIO API GENTLE MUSIC BOX LULLABY (NO EXTERNAL AUDIO URLS)
         * ------------------------------------------------------------------- */
        let audioCtx = null;
        let isMusicPlaying = false;
        let lullabyTimer = null;

        // Twinkle Twinkle / Carousel Waltz Lullaby Notes (Hz)
        const melodyNotes = [
            { freq: 523.25, dur: 0.45 }, // C5
            { freq: 523.25, dur: 0.45 }, // C5
            { freq: 783.99, dur: 0.45 }, // G5
            { freq: 783.99, dur: 0.45 }, // G5
            { freq: 880.00, dur: 0.45 }, // A5
            { freq: 880.00, dur: 0.45 }, // A5
            { freq: 783.99, dur: 0.85 }, // G5
            { freq: 698.46, dur: 0.45 }, // F5
            { freq: 698.46, dur: 0.45 }, // F5
            { freq: 659.25, dur: 0.45 }, // E5
            { freq: 659.25, dur: 0.45 }, // E5
            { freq: 587.33, dur: 0.45 }, // D5
            { freq: 587.33, dur: 0.45 }, // D5
            { freq: 523.25, dur: 0.90 }  // C5
        ];
        let noteIndex = 0;

        function playMusicBoxTone(freq, duration) {
            if (!audioCtx) return;
            const now = audioCtx.currentTime;
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();

            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, now);

            // Soft music-box chime envelope
            gain.gain.setValueAtTime(0.001, now);
            gain.gain.exponentialRampToValueAtTime(0.08, now + 0.03);
            gain.gain.exponentialRampToValueAtTime(0.0008, now + duration + 0.35);

            osc.connect(gain);
            gain.connect(audioCtx.destination);

            osc.start(now);
            osc.stop(now + duration + 0.4);
        }

        function startMusicBox() {
            try {
                if (!audioCtx) {
                    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                    audioCtx = new AudioContextClass();
                }
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
                if (isMusicPlaying) return;

                isMusicPlaying = true;
                updateMusicButtonUI();

                const step = () => {
                    if (!isMusicPlaying) return;
                    const note = melodyNotes[noteIndex % melodyNotes.length];
                    playMusicBoxTone(note.freq, note.dur);
                    noteIndex++;
                    lullabyTimer = setTimeout(step, note.dur * 1050);
                };
                step();
            } catch (err) {
                console.warn('Audio playback prevented until user gesture:', err);
            }
        }

        function stopMusicBox() {
            isMusicPlaying = false;
            clearTimeout(lullabyTimer);
            updateMusicButtonUI();
        }

        function toggleMusic() {
            if (isMusicPlaying) {
                stopMusicBox();
            } else {
                startMusicBox();
            }
        }

        function updateMusicButtonUI() {
            const icon = document.getElementById('music-icon');
            const label = document.getElementById('music-label');
            if (isMusicPlaying) {
                icon.textContent = '🎶';
                label.textContent = 'Music: On';
            } else {
                icon.textContent = '🔇';
                label.textContent = 'Music: Off';
            }
        }

        /* -------------------------------------------------------------------
         * 3. OPEN MAGIC ENVELOPE & SPARKLE BURST
         * ------------------------------------------------------------------- */
        function createSparkleBurst(x, y) {
            const emojis = ['✨', '⭐', '💙', '💗', '🎠', '🧸'];
            for (let i = 0; i < 18; i++) {
                const dot = document.createElement('span');
                dot.className = 'burst-dot';
                dot.textContent = emojis[i % emojis.length];
                dot.style.left = x + 'px';
                dot.style.top = y + 'px';
                document.body.appendChild(dot);

                const angle = (Math.PI * 2 * i) / 18;
                const dist = 65 + Math.random() * 95;
                const tx = Math.cos(angle) * dist;
                const ty = Math.sin(angle) * dist;

                requestAnimationFrame(() => {
                    dot.style.transform = `translate(${tx}px, ${ty}px) scale(1.2)`;
                    dot.style.opacity = '0';
                });

                setTimeout(() => dot.remove(), 950);
            }
        }

        function openMagicEnvelope(event) {
            const wrapper = document.getElementById('magic-envelope-wrapper');
            const overlay = document.getElementById('intro-overlay');
            const main = document.getElementById('main-invitation');

            // Sparkle burst at click coordinates
            const rect = event.currentTarget.getBoundingClientRect();
            const cx = rect.left + rect.width / 2;
            const cy = rect.top + rect.height / 2;
            createSparkleBurst(cx, cy);

            // Start gentle music-box melody
            startMusicBox();

            // Unfold envelope flap
            wrapper.classList.remove('animate-envelope');
            wrapper.classList.add('envelope-opened');

            // Fade out overlay & reveal main invitation
            setTimeout(() => {
                overlay.style.opacity = '0';
                overlay.style.transform = 'scale(1.04)';
                main.classList.remove('opacity-0');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }, 650);

            setTimeout(() => {
                overlay.classList.add('hidden');
            }, 1550);
        }

        function replayEnvelopeIntro() {
            const wrapper = document.getElementById('magic-envelope-wrapper');
            const overlay = document.getElementById('intro-overlay');
            wrapper.classList.remove('envelope-opened');
            wrapper.classList.add('animate-envelope');
            overlay.classList.remove('hidden');
            requestAnimationFrame(() => {
                overlay.style.opacity = '1';
                overlay.style.transform = 'scale(1)';
            });
        }

        /* -------------------------------------------------------------------
         * 4. LIVE COUNTDOWN TIMER TO BABY YOHANNE'S BAPTISM
         * ------------------------------------------------------------------- */
        let targetBaptismDate = new Date('2026-11-29T05:30:00');

        function updateCountdown() {
            const now = new Date();
            const diff = targetBaptismDate - now;

            const daysEl = document.getElementById('cd-days');
            const hoursEl = document.getElementById('cd-hours');
            const minsEl = document.getElementById('cd-mins');
            const secsEl = document.getElementById('cd-secs');

            if (diff <= 0) {
                daysEl.textContent = '00';
                hoursEl.textContent = '00';
                minsEl.textContent = '00';
                secsEl.textContent = '00';
                return;
            }

            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
            const mins = Math.floor((diff / 1000 / 60) % 60);
            const secs = Math.floor((diff / 1000) % 60);

            daysEl.textContent = String(days).padStart(2, '0');
            hoursEl.textContent = String(hours).padStart(2, '0');
            minsEl.textContent = String(mins).padStart(2, '0');
            secsEl.textContent = String(secs).padStart(2, '0');
        }

        /* -------------------------------------------------------------------
         * 5. INTERACTIVE CLICKABLE GIFT CARDS
         * ------------------------------------------------------------------- */
        function selectGiftCard(btn, giftName) {
            const rect = btn.getBoundingClientRect();
            createSparkleBurst(rect.left + rect.width / 2, rect.top + rect.height / 2);

            // Highlight selected state
            btn.classList.toggle('ring-4');
            btn.classList.toggle('ring-gold-antique/60');
            const badge = btn.querySelector('.gift-badge');
            const isSelected = btn.classList.contains('ring-4');
            if (badge) {
                badge.textContent = isSelected ? 'Chosen with love! 💙' : 'Tap to pick ✨';
            }

            const feedback = document.getElementById('gift-feedback-box');
            feedback.classList.remove('hidden');
            feedback.innerHTML = `🧸✨ Thank you so much for considering <strong>${giftName}</strong> for Baby Yohanne Rei! Your thoughtfulness means the world to us. 💙`;
        }

        /* -------------------------------------------------------------------
         * 6. RSVP & WISHES WALL SUBMISSION
         * ------------------------------------------------------------------- */
        function submitRsvp(event) {
            event.preventDefault();
            const nameInput = document.getElementById('guest-name');
            const statusInput = document.getElementById('guest-status');
            const paxInput = document.getElementById('guest-pax');
            const wishInput = document.getElementById('guest-wish');
            const container = document.getElementById('wishes-container');
            const toast = document.getElementById('rsvp-toast');

            const name = nameInput.value.trim();
            const status = statusInput.value;
            const pax = paxInput.value;
            const wish = wishInput.value.trim();

            if (!name || !wish) return;

            const card = document.createElement('div');
            card.className = 'bg-white/95 p-3.5 rounded-2xl border border-sky-accent/40 shadow-sm transition-all';
            card.innerHTML = `
                <div class="flex items-center justify-between gap-2">
                    <span class="font-whimsy font-bold text-sm text-navy-slate">${escapeHtml(name)}</span>
                    <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-pink-dusty/60 text-navy-slate font-bold">${escapeHtml(status)} (${escapeHtml(pax)})</span>
                </div>
                <p class="text-xs sm:text-sm text-navy-slate/85 mt-1">"${escapeHtml(wish)}"</p>
            `;
            container.prepend(card);

            toast.classList.remove('hidden');
            toast.textContent = `🎉 Thank you, ${name}! Your RSVP and blessing for Baby Yohanne Rei have been posted!`;

            nameInput.value = '';
            wishInput.value = '';
        }

        function escapeHtml(str) {
            return str.replace(/[&<>"']/g, (m) => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            })[m]);
        }

        /* -------------------------------------------------------------------
         * 7. CUSTOMIZE MODAL LOGIC (DATE, VENUES, AND PHOTO REPLACEMENTS)
         * ------------------------------------------------------------------- */
        function openCustomizeModal() {
            const modal = document.getElementById('customize-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeCustomizeModal() {
            const modal = document.getElementById('customize-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function previewCustomPhoto(event, targetIds) {
            const file = event.target.files && event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                targetIds.forEach(id => {
                    const img = document.getElementById(id);
                    if (img) img.src = e.target.result;
                });
            };
            reader.readAsDataURL(file);
        }

        function saveCustomizations() {
            const dtVal = document.getElementById('edit-datetime').value;
            const churchName = document.getElementById('edit-church').value.trim();
            const churchAddr = document.getElementById('edit-church-addr').value.trim();
            const recName = document.getElementById('edit-reception').value.trim();
            const recAddr = document.getElementById('edit-reception-addr').value.trim();

            if (dtVal) {
                targetBaptismDate = new Date(dtVal);
                const formatted = targetBaptismDate.toLocaleDateString('en-US', {
                    weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
                });
                const timeFormatted = targetBaptismDate.toLocaleTimeString('en-US', {
                    hour: 'numeric', minute: '2-digit'
                });
                document.getElementById('display-event-date-subtitle').textContent = `${formatted} • ${timeFormatted}`;
                document.getElementById('display-time-badge').innerHTML = `⏰ Ceremony Time: <span class="text-sky-accent">${timeFormatted}</span>`;
                updateCountdown();
            }

            if (churchName) document.getElementById('display-church-name').textContent = churchName;
            if (churchAddr) document.getElementById('display-church-address').textContent = churchAddr;
            if (recName) document.getElementById('display-reception-name').textContent = recName;
            if (recAddr) document.getElementById('display-reception-address').textContent = recAddr;

            closeCustomizeModal();
        }

        // Initialize on Window Load
        window.onload = function() {
            createAmbientParticles();
            updateCountdown();
            setInterval(updateCountdown, 1000);
        };
    </script>
