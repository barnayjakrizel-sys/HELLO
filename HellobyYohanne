         class="fixed inset-0 z-40 flex flex-col items-center justify-center px-4 py-6 bg-gradient-to-b from-[#CBE8FF] via-[#EAF6FF] to-[#FCE4EC] transition-all duration-1000 overflow-y-auto">

        <!-- Magical Floating Clouds & Stars Top -->
        <div class="max-w-lg w-full flex flex-col items-center text-center relative my-auto">

            <!-- Top Magical Banner & Flying Teddy Bear with Wand -->
            <div class="relative flex flex-col items-center mb-3">
                <!-- Animated Flying Cartoon Teddy Bear SVG -->
