                        <p class="font-serif-royal font-bold text-xl sm:text-2xl tracking-wider gold-text-gradient drop-shadow-sm uppercase">
                            YOU ARE INVITED!
                        </p>
                        <p class="font-whimsy text-xs sm:text-sm font-bold text-navy-slate/80 mt-0.5">
                            Baby Yohanne Rei's Holy Baptism
                        </p>

                        <!-- CLICKABLE GOLDEN CAROUSEL WAX SEAL -->
                        <button id="open-seal-btn"
                                onclick="openMagicEnvelope(event)"
                                class="animate-seal mt-3 w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-gradient-to-br from-[#F7DF8B] via-[#D4AF37] to-[#9E7614] border-4 border-[#FFF8DC] flex flex-col items-center justify-center text-white cursor-pointer focus:outline-none group relative"
                                aria-label="Click the seal to open invitation">
                            <span class="absolute inset-1.5 rounded-full border border-white/60"></span>
                            <span class="text-2xl sm:text-3xl group-hover:scale-110 transition-transform">🎠</span>
                            <span class="text-[9px] sm:text-[10px] font-whimsy font-extrabold tracking-widest uppercase text-[#FFFDF7] drop-shadow">
                                OPEN
                            </span>
                        </button>

                        <span class="mt-2.5 inline-flex items-center gap-1 px-3 py-1 rounded-full bg-white/90 border border-gold-antique/50 text-navy-slate font-whimsy font-bold text-xs shadow-sm">
                            ✨ (Click the seal to open) ✨
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- MAIN INVITATION CONTENT (REVEALED AFTER OPENING ENVELOPE)             -->
    <!-- ===================================================================== -->
    <main id="main-invitation" class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 pt-16 pb-20 space-y-10 sm:space-y-14 opacity-0 transition-opacity duration-1000">

        <!-- ================================================================= -->
        <!-- SECTION 1: COUNTDOWN TO BABY YOHANNE'S BAPTISM + HERO & PHOTOS    -->
        <!-- ================================================================= -->
        <section id="section-countdown-hero" class="royal-card rounded-[2.25rem] p-6 sm:p-10 text-center relative overflow-hidden">
            <!-- Corner Pastel Ribbons & Stars -->
            <div class="absolute top-3 left-4 text-2xl twinkle-light" aria-hidden="true">🌟</div>
            <div class="absolute top-3 right-4 text-2xl twinkle-light" style="animation-delay: 0.6s;" aria-hidden="true">🌟</div>

            <!-- COUNTDOWN BANNER (First thing seen right after opening!) -->
