                        <!-- Teddy Ears -->
                        <circle cx="67" cy="64" r="14" fill="#C68B59"/>
                        <circle cx="67" cy="64" r="8" fill="#F3D5B5"/>
                        <circle cx="113" cy="64" r="14" fill="#C68B59"/>
                        <circle cx="113" cy="64" r="8" fill="#F3D5B5"/>
                        <!-- Little Royal Crown -->
                        <path d="M78 49L83 37L90 45L97 37L102 49H78Z" fill="#F5D76E" stroke="#B8860B" stroke-width="1.5"/>
                        <!-- Teddy Body -->
                        <ellipse cx="90" cy="126" rx="28" ry="26" fill="#C68B59"/>
                        <ellipse cx="90" cy="128" rx="18" ry="17" fill="#F3D5B5"/>
                        <!-- Baby Blue Bowtie -->
                        <path d="M80 107L90 112L80 117V107Z" fill="#4A90E2"/>
                        <path d="M100 107L90 112L100 117V107Z" fill="#4A90E2"/>
                        <circle cx="90" cy="112" r="3.5" fill="#F5D76E"/>
                        <!-- Teddy Arms (Left holding balloon, Right holding magic star wand) -->
                        <ellipse cx="61" cy="116" rx="13" ry="8" transform="rotate(-25 61 116)" fill="#C68B59"/>
                        <ellipse cx="119" cy="112" rx="14" ry="8" transform="rotate(-35 119 112)" fill="#C68B59"/>
                        <!-- Magic Star Wand -->
                        <line x1="126" y1="106" x2="146" y2="76" stroke="#D4AF37" stroke-width="3" stroke-linecap="round"/>
                        <path d="M146 64L149.5 72L158 73L151.5 78.5L153.5 87L146 82.5L138.5 87L140.5 78.5L134 73L142.5 72L146 64Z" fill="#F5D76E" stroke="#B8860B" stroke-width="1.2"/>
                        <!-- Teddy Head -->
                        <circle cx="90" cy="82" r="26" fill="#C68B59"/>
                        <!-- Muzzle -->
                        <ellipse cx="90" cy="89" rx="12" ry="9" fill="#F3D5B5"/>
                        <!-- Eyes & Rosy Cheeks -->
                        <circle cx="80" cy="79" r="3" fill="#24364B"/>
                        <circle cx="81" cy="78" r="1" fill="#FFFFFF"/>
                        <circle cx="100" cy="79" r="3" fill="#24364B"/>
                        <circle cx="101" cy="78" r="1" fill="#FFFFFF"/>
                        <ellipse cx="73" cy="86" rx="4" ry="2.5" fill="#F5A3B7" fill-opacity="0.75"/>
                        <ellipse cx="107" cy="86" rx="4" ry="2.5" fill="#F5A3B7" fill-opacity="0.75"/>
                        <!-- Cute Nose & Smile -->
                        <ellipse cx="90" cy="86" rx="4" ry="2.8" fill="#5C3A21"/>
                        <path d="M85 92Q90 96 95 92" stroke="#5C3A21" stroke-width="2" stroke-linecap="round"/>
                        <!-- Teddy Feet -->
                        <ellipse cx="74" cy="148" rx="11" ry="8" fill="#B07647"/>
                        <ellipse cx="74" cy="148" rx="6" ry="4.5" fill="#F3D5B5"/>
                        <ellipse cx="106" cy="148" rx="11" ry="8" fill="#B07647"/>
                        <ellipse cx="106" cy="148" rx="6" ry="4.5" fill="#F3D5B5"/>
                    </svg>
                </div>

                <span class="px-4 py-1 rounded-full bg-white/85 border border-gold-antique/50 text-sky-accent font-whimsy font-bold text-xs tracking-widest uppercase shadow-sm -mt-2">
                    ✨ Magic Carousel Baptism ✨
                </span>
            </div>

            <!-- LARGE ANIMATED SEALED ENVELOPE -->
            <div id="magic-envelope-wrapper" class="animate-envelope w-full max-w-md mx-auto relative select-none">
                <!-- Decorative Floating Hearts & Stars around Envelope -->
                <span class="absolute -left-2 top-8 text-2xl animate-bounce" aria-hidden="true">💙</span>
                <span class="absolute -right-2 top-10 text-2xl animate-bounce" style="animation-delay: 0.5s;" aria-hidden="true">💗</span>
                <span class="absolute left-6 -bottom-4 text-xl twinkle-light" aria-hidden="true">⭐</span>
                <span class="absolute right-6 -bottom-4 text-xl twinkle-light" style="animation-delay: 0.7s;" aria-hidden="true">✨</span>

                <!-- Envelope Body -->
                <div class="relative w-full aspect-[16/11] bg-gradient-to-br from-[#FFFDF7] via-[#FDF6E4] to-[#F7E8C8] rounded-3xl border-[3px] border-gold-antique shadow-[0_22px_50px_rgba(36,54,75,0.22)] overflow-hidden flex flex-col items-center justify-center p-5">

                    <!-- Inner Gold Filigree Border -->
                    <div class="absolute inset-2.5 rounded-2xl border border-dashed border-gold-antique/60 pointer-events-none"></div>

                    <!-- Peeking Card Inside (slides up on open) -->
                    <div class="letter-peek absolute inset-x-6 top-6 bottom-6 bg-sky-pastel rounded-xl border border-gold-antique/40 flex items-center justify-center transition-transform duration-700 pointer-events-none">
                        <p class="font-script text-2xl text-navy-slate">Baby Yohanne Rei</p>
                    </div>

                    <!-- Envelope Side & Bottom Fold Lines (SVG) -->
                    <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 400 275" preserveAspectRatio="none">
                        <!-- Left Flap -->
                        <polygon points="0,0 190,145 0,275" fill="#FBF2DC" fill-opacity="0.85" stroke="#D4AF37" stroke-width="1.2"/>
                        <!-- Right Flap -->
                        <polygon points="400,0 210,145 400,275" fill="#FBF2DC" fill-opacity="0.85" stroke="#D4AF37" stroke-width="1.2"/>
                        <!-- Bottom Flap -->
                        <polygon points="0,275 200,132 400,275" fill="#FFFDF7" stroke="#D4AF37" stroke-width="1.5"/>
                    </svg>

                    <!-- Top Envelope Flap -->
                    <div class="envelope-flap absolute top-0 inset-x-0 h-[56%] pointer-events-none z-10">
                        <svg class="w-full h-full drop-shadow-md" viewBox="0 0 400 155" preserveAspectRatio="none">
                            <polygon points="0,0 400,0 200,150" fill="url(#flapGrad)" stroke="#D4AF37" stroke-width="2"/>
                            <defs>
                                <linearGradient id="flapGrad" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#FFFDF7"/>
                                    <stop offset="100%" stop-color="#F5E4BE"/>
                                </linearGradient>
                            </defs>
                        </svg>
                    </div>

                    <!-- Envelope Front Text & Clickable Wax Seal -->
