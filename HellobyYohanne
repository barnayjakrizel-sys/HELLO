                        <path d="M242 138L232 122L225 126L236 144Z" fill="#FFFDF7" stroke="#F5C2D1" stroke-width="2"/>
                        <circle cx="230" cy="123" r="6" fill="#FFFDF7" stroke="#F5C2D1" stroke-width="2"/>
                        <!-- Pastel Blue Saddle -->
                        <path d="M249 132Q258 140 267 132Z" fill="#8ECAE6" stroke="#D4AF37" stroke-width="1.5"/>
                        <line x1="244" y1="151" x2="236" y2="164" stroke="#F5C2D1" stroke-width="3" stroke-linecap="round"/>
